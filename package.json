{
  "name": "dsh-agent-master",
  "version": "0.1.0",
  "description": "Master 对话指挥多子对话：共享黑板 + 约束台账 + 结构化交接契约 + 指挥台面板。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "scripts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dshGo": {
    "v": 1,
    "title": { "zh": "指挥台", "en": "Command deck" },
    "contributes": {
      "panels": [
        { "id": "deck", "title": { "zh": "指挥台", "en": "Deck" }, "placement": ["session.tab"] }
      ]
    }
  },
  "engines": { "dsh": ">=0.2.1-rc.2 <0.3.0-0" },
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:e2e": "node scripts/e2e-probe.mjs",
    "test:legacy": "node --test test/*.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "multi-conversation",
    "orchestration",
    "blackboard"
  ]
}
